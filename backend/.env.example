# --- App ---
APP_NAME=SoilEdge Field System
APP_ENV=dev
APP_PORT=8000

# --- Security ---
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-please-use-a-long-random-string-32+chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
# SQLite for dev. Switch to postgresql+psycopg2://user:pass@host:5432/dbname later.
DATABASE_URL=sqlite:///./soiledge.db

# --- CORS ---
# Comma-separated list of allowed origins. Use * only in dev.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5500

# --- Copernicus / Sentinel ---
# Register at https://dataspace.copernicus.eu/ (free)
COPERNICUS_CLIENT_ID=your-client-id
COPERNICUS_CLIENT_SECRET=your-client-secret
COPERNICUS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
COPERNICUS_PROCESS_URL=https://sh.dataspace.copernicus.eu/api/v1/process
COPERNICUS_CATALOGUE_URL=https://catalogue.dataspace.copernicus.eu/odata/v1
# How far back to look for a cloud-free scene (days)
COPERNICUS_LOOKBACK_DAYS=15
# Max cloud cover % for a scene to be accepted
COPERNICUS_MAX_CLOUD_PCT=30

# --- Telemetry rate limit ---
# Max POSTs per device per minute
TELEMETRY_RATE_PER_MIN=60
